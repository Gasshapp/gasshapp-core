{
  "name": "@gasshapp-core/db",
  "version": "0.1.0",
  "description": "Shared core database schema (users, groups, tags, contacts)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "gasshapp",
    "core",
    "database",
    "drizzle"
  ],
  "license": "UNLICENSED"
}
